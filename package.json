{
  "name": "trisakay-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:passenger": "npm --workspace apps/passenger run start",
    "start:driver": "npm --workspace apps/driver run start",
    "dev:admin": "npm --workspace apps/admin run dev",
    "build:admin": "npm --workspace apps/admin run build",
    "test:passenger": "npm --workspace apps/passenger run test",
    "test:driver": "npm --workspace apps/driver run test",
    "test:admin": "npm --workspace apps/admin run test",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.9.2"
  }
}
