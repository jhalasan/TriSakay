{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@trisakay/shared": ["packages/shared/src/index.ts"],
      "@trisakay/services": ["packages/services/src/index.ts"],
      "@trisakay/ui": ["packages/ui/src/index.ts"],
      "@trisakay/utils": ["packages/utils/src/index.ts"]
    }
  },
  "files": [],
  "references": [
    { "path": "./apps/passenger" },
    { "path": "./apps/driver" },
    { "path": "./apps/admin" },
    { "path": "./packages/shared" },
    { "path": "./packages/services" },
    { "path": "./packages/ui" },
    { "path": "./packages/utils" }
  ]
}
