VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# G2: the "web" key from Google Cloud Console, restricted by HTTP referrer to
# this app's domain (see docs/UAT_PANELIST_REVIEW_ADRALES.md, "## G2: full
# Google stack"). Shipping it in the client bundle is expected for a Maps JS
# API key — the referrer restriction is what protects it, not secrecy.
VITE_GOOGLE_MAPS_WEB_API_KEY=your-google-maps-web-key
# Optional: a Map ID (Cloud Console > Maps Management > Map ID, vector
# rendering, free) — enables AdvancedMarker's custom badge/pin content in
# LiveMap and AlertLocationMap. Without it, markers fall back to a plain pin.
VITE_GOOGLE_MAPS_MAP_ID=your-map-id
